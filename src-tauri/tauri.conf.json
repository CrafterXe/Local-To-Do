{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local To Do",
  "version": "1.2.0",
  "identifier": "com.localtodo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Local To Do",
        "width": 1200,
        "height": 780,
        "minWidth": 880,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "decorations": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Local To Do",
    "category": "Productivity",
    "shortDescription": "本地优先的任务与备忘录管理",
    "longDescription": "Local To Do 是一款完全本地运行的个人任务与备忘录管理软件，支持提醒、重复任务、清单与笔记。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
